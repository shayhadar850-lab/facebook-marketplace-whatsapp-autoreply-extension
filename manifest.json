{
  "manifest_version": 3,
  "name": "מענה אוטומטי ל-Marketplace",
  "description": "מענה אוטומטי בעברית לשיחות Marketplace שלא נענו והפניה לוואטסאפ.",
  "version": "1.0.1",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://www.facebook.com/*"],
  "action": {
    "default_title": "מענה Marketplace",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/marketplace/inbox*"],
      "js": ["utils.content.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["utils.mjs"],
      "matches": ["https://www.facebook.com/*"]
    }
  ]
}
